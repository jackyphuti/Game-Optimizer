{
  "name": "apex-overdrive",
  "productName": "Apex Overdrive",
  "version": "3.0.1",
  "description": "Apex Overdrive - Next-Gen Automotive Gaming Engine & Hardware Optimizer",
  "main": "main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron main.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux deb rpm AppImage"
  },
  "author": {
    "name": "Jacky Phuti",
    "email": "jackyphuti@users.noreply.github.com"
  },
  "homepage": "https://github.com/jackyphuti/Game-Optimizer",
  "license": "MIT",
  "dependencies": {
    "systeminformation": "^5.33.15"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.apexoverdrive.optimizer",
    "productName": "Apex Overdrive",
    "directories": {
      "output": "../dist-gui"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "assets/**/*",
      "native/**/*"
    ],
    "asarUnpack": [
      "native/**/*"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Game",
      "maintainer": "Jacky Phuti <jackyphuti@users.noreply.github.com>",
      "icon": "assets/logo_512.png"
    }
  }
}
